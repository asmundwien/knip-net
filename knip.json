{
  // Knip.NET configuration (config-as-code). All keys are optional; defaults are tuned for
  // ASP.NET Core + xUnit/NUnit. Only what you set here overrides the defaults.
  //
  // Any UNKNOWN key here (top-level or nested) is warned by name and then ignored — a typo never
  // silently no-ops (nor changes the exit code). Inspect the effective merged config (this file over
  // the defaults) with `dotnet-knip --print-config`. Trace one symbol with `dotnet-knip --why <id-or-name>`.
  "$schema": "./schemas/knip.config.schema.json",

  // "solution": "path/to/Your.sln",   // or pass on the CLI: dotnet-knip Your.sln

  // Production mode is off by default. In default mode every [Fact]/[Theory] is a root, so
  // test-only production code stays alive. Enable it here or with --production to report that code as
  // `onlyUsedByTests` with remediation `deleteCodeAndTests`. Directly
  // test-referenced findings list tests under details.testReferrers; transitive findings point through
  // rootCause to that direct boundary. The boundary's confidence governs the whole deletion unit: a dead
  // feature plus its test suite.
  // "production": true,

  // Test-project classification uses the first matching rule. These `testProjects` globs override
  // everything. Otherwise Knip.NET checks for a referenced test-framework assembly
  // (MSTest.TestFramework / xunit.core / nunit.framework), then name globs
  // (*Tests / *.Test / *.Tests). Zero test projects in production mode adds a visible warning to
  // stderr and reliability.productionModeWarnings; it does not fail the run. Set this only when
  // auto-detection misclassifies a project, for example one named "Verification".
  // "testProjects": ["*.IntegrationTests", "My.Test.Harness"],

  "entryPoints": {
    // Explicit custom members the framework/runtime invokes without a by-name reference in source.
    "symbolNames": [],

    // Test frameworks (incl. MSTest/NUnit lifecycle hooks the runner invokes) + ASP.NET routing.
    "attributes": [
      "Fact", "Theory",
      "TestMethod", "DataTestMethod",
      "TestInitialize", "TestCleanup", "ClassInitialize", "ClassCleanup",
      "AssemblyInitialize", "AssemblyCleanup",
      "Test", "TestCase", "SetUp", "TearDown", "OneTimeSetUp", "OneTimeTearDown",
      "HttpGet", "HttpPost", "HttpPut", "HttpDelete"
    ],
    "baseTypes": [
      "Microsoft.AspNetCore.Mvc.ControllerBase",
      "Microsoft.AspNetCore.Components.ComponentBase"
    ],
    "implementedInterfaces": ["Microsoft.Extensions.Hosting.IHostedService"],
    "namePatterns": ["*Controller"]
  },

  "roots": {
    // For a solution of shared libraries consumed by OTHER repos, the public surface is "used"
    // externally. Flip this on to report only internally-dead code (private/internal helpers).
    "treatAllPublicAsUsed": false,

    // Or scope it: project-name globs whose public API is treated as the used surface.
    "publicApiProjects": ["*.Abstractions", "*.Contracts"]
  },

  "ignore": {
    // Generated code and build output are ignored by default; add project-specific patterns here.
    "files": ["**/*.g.cs", "**/obj/**", "**/bin/**", "**/Migrations/**"],
    // Reflection/serialization targets that look dead but aren't. Globs match a symbol by its
    // FULLY-QUALIFIED name — the same shape shown in findings: namespace + containing type + member,
    // with parameters for methods (e.g. "MyApp.Dtos.OrderDto", "MyApp.Foo.Bar()"). Bare member-name
    // globs do NOT match members; qualify them (e.g. "*.Dtos.*", "MyApp.Foo.Handle*").
    "symbols": ["*.Dtos.*", "MyApp.Generated.*"],
    "namespaces": [],
    "projects": []
  },

  "output": {
    "format": "console"   // console | json | sarif
  },

  "plugins": {
    // Built-in analysis plugins keep alive usages the core walker cannot see (reflection strings,
    // scanning DI, serialized DTOs, markup binding). Each plugin is ADD-ONLY: it can keep code alive
    // (avoid a false positive) but never mark live code dead. Keyed by camelCase plugin id.
    //
    // Unknown plugin ids and unknown per-plugin keys are NOT silently ignored — they print a visible
    // "warning:" so a typo (e.g. "reflectoin" or "enabldd") is caught instead of quietly no-opping.

    // reflection — ON by default. Keeps alive types/members named only via reflection strings/typeof:
    //   Type.GetType("Ns.Foo"), Activator.CreateInstance(typeof(Foo)/"Ns.Foo"),
    //   typeof(T).GetMethod("X") / x.GetType().GetMethod("X") (also GetProperty/GetField/GetEvent).
    // Conservative: only contributes when it can resolve the target symbol from the string/typeof.
    "reflection": { "enabled": true },

    // scanningDi — ON by default. Roots constructor dependency closures for Microsoft DI Add/TryAdd
    // Singleton, Scoped, and Transient registrations when the overload proves container activation.
    // Factory/instance overloads retain findings but attach diPluginShaped to unresolved constructor
    // dependencies. Also keeps alive assembly-scanned types by framework marker shape:
    //   • MediatR handlers    — implement IRequestHandler / INotificationHandler / IStreamRequestHandler
    //   • MassTransit         — implement IConsumer / IConsumer<T>
    //   • AutoMapper profiles — derive from a base named Profile
    // It never blanket-roots every interface implementer or unrelated member.
    "scanningDi": { "enabled": true },

    // blazorParameter — OFF by default (opt-in). Keeps alive Blazor component members set from .razor
    // markup or the DI container, which the walker never sees assigned in C#. Roots properties carrying
    // [Parameter] / [CascadingParameter] / [SupplyParameterFromQuery] / [EditorRequired] / [Inject]
    // (matched by attribute NAME, offline). Conservative: roots ONLY the attribute-bearing member and
    // its accessors — never blanket-roots a component's members, so plain siblings stay flagged. Enable
    // it if your solution has Blazor components:
    "blazorParameter": { "enabled": false },

    // serialization — OFF by default (opt-in). Keeps alive DTO data members touched only by a JSON
    // serializer (reflection over the type's properties/fields), which the walker never sees named in
    // source. Roots the public get/set PROPERTIES and public FIELDS of a DEMONSTRABLY-serialized type:
    //   • the type argument or the serialized value of a serialize/deserialize call —
    //     JsonSerializer.Serialize<T>/Deserialize<T> (System.Text.Json),
    //     JsonConvert.SerializeObject/DeserializeObject<T> (Newtonsoft), matched by method NAME offline;
    //   • plus any member wearing [JsonPropertyName] / [JsonProperty] / [DataMember] (matched by name).
    // Conservative: roots ONLY serialized types' own data members — never blanket-roots every property,
    // so non-serialized types' plain members and unrelated dead types stay flagged. Optional
    // "namespaces" glob list also roots the data members of types in matching namespaces (a "these are
    // DTOs" escape hatch for serialization the plugin cannot statically see). Enable it if your solution
    // serializes DTOs:
    "serialization": { "enabled": false, "namespaces": [] },

    // aspnetcore — ON by default (disable with "enabled": false). Keeps alive ASP.NET Core CONVENTION-INVOKED members the
    // framework dispatches by REFLECTION, so no source names them: app.UseMiddleware<T>() keeps the TYPE
    // alive but the middleware's Invoke/InvokeAsync(HttpContext) is called reflectively, so the entry
    // method + ctor + fields (_next/_logger) + private helpers cascade to false positives; likewise an
    // MVC/Razor filter's interface method is framework-dispatched, so its private helpers cascade dead.
    // Roots the convention ENTRY members (making them reachable so their fields/ctors/helpers gain
    // liveness via normal edges), matched by framework-type NAME offline:
    // Every recognized framework-activated type's explicit instance constructors are rooted as well.
    //   • for each UseMiddleware<T>() / UseMiddleware(typeof(T)) → T's Invoke + InvokeAsync + instance ctors;
    //   • IMiddleware implementers → InvokeAsync;
    //   • MVC/Razor filters (IActionFilter/IAsyncActionFilter/IResultFilter/IAsyncResultFilter/
    //     IExceptionFilter/IAsyncExceptionFilter/IAuthorizationFilter/IAsyncAuthorizationFilter/
    //     IPageFilter/IAsyncPageFilter) → the type's implementations of those interface methods;
    //   • IStartupFilter implementers → Configure;
    //   • authorization handlers (derive from AuthorizationHandler<T> or implement IAuthorizationHandler)
    //     → HandleRequirementAsync + HandleAsync + instance ctors (policy evaluation dispatches these, so
    //     the handler's fields — _logger, _authenticationStateProvider — and helpers would cascade dead);
    //   • Blazor components (derive from ComponentBase) → the lifecycle methods (OnInitialized/…Async,
    //     OnParametersSet/…Async, OnAfterRender/…Async, SetParametersAsync, BuildRenderTree, Dispose/…Async)
    //     the renderer invokes by convention. ([Parameter] props are the separate blazorParameter plugin.)
    //   • Application Insights telemetry (implement ITelemetryProcessor → Process; ITelemetryInitializer →
    //     Initialize) + instance ctors — the pipeline dispatches these, so the ctor-assigned _next + helpers
    //     would cascade dead;
    //   • Health checks (implement IHealthCheck) → CheckHealthAsync + instance ctors;
    //   • Authorization policy providers (implement IAuthorizationPolicyProvider or derive from
    //     DefaultAuthorizationPolicyProvider) → GetPolicyAsync/GetDefaultPolicyAsync/GetFallbackPolicyAsync +
    //     instance ctors.
    // Conservative: roots ONLY the convention entry members, never blanket-roots a middleware/filter's
    // world — an unrelated dead method the entry point never calls stays flagged. Shown at its default
    // (ON); set "enabled": false to turn it off for non-ASP.NET Core solutions:
    "aspnetcore": { "enabled": true }
  }
}
