{
  // Knip.NET configuration (config-as-code). All keys are optional; defaults are tuned for
  // ASP.NET Core + xUnit/NUnit. Only what you set here overrides the defaults.
  "$schema": "./schemas/knip.config.schema.json",

  // "solution": "path/to/Your.sln",   // or pass on the CLI: dotnet-knip Your.sln

  "entryPoints": {
    // Members the framework/runtime invokes without a by-name reference in your code.
    "symbolNames": ["Main", "ConfigureServices", "Configure"],
    // Test frameworks (incl. MSTest/NUnit lifecycle hooks the runner invokes) + ASP.NET routing.
    "attributes": [
      "Fact", "Theory",
      "TestMethod", "DataTestMethod",
      "TestInitialize", "TestCleanup", "ClassInitialize", "ClassCleanup",
      "AssemblyInitialize", "AssemblyCleanup",
      "Test", "TestCase", "SetUp", "TearDown", "OneTimeSetUp", "OneTimeTearDown",
      "HttpGet", "HttpPost", "HttpPut", "HttpDelete"
    ],
    "baseTypes": [
      "Microsoft.AspNetCore.Mvc.ControllerBase",
      "Microsoft.AspNetCore.Components.ComponentBase"
    ],
    "implementedInterfaces": ["Microsoft.Extensions.Hosting.IHostedService"],
    "namePatterns": ["*Controller"]
  },

  "roots": {
    // For a solution of shared libraries consumed by OTHER repos, the public surface is "used"
    // externally. Flip this on to report only internally-dead code (private/internal helpers).
    "treatAllPublicAsUsed": false,

    // Or scope it: project-name globs whose public API is treated as the used surface.
    "publicApiProjects": ["*.Abstractions", "*.Contracts"]
  },

  "ignore": {
    // Generated code and build output are ignored by default; add project-specific patterns here.
    "files": ["**/*.g.cs", "**/obj/**", "**/bin/**", "**/Migrations/**"],
    // Reflection/serialization targets that look dead but aren't. Globs match a symbol by its
    // FULLY-QUALIFIED name — the same shape shown in findings: namespace + containing type + member,
    // with parameters for methods (e.g. "MyApp.Dtos.OrderDto", "MyApp.Foo.Bar()"). Bare member-name
    // globs do NOT match members; qualify them (e.g. "*.Dtos.*", "MyApp.Foo.Handle*").
    "symbols": ["*.Dtos.*", "MyApp.Generated.*"],
    "namespaces": [],
    "projects": []
  },

  "output": {
    "format": "console"   // console | json | sarif
  },

  "plugins": {
    // Built-in analysis plugins keep alive usages the core walker cannot see (reflection strings,
    // scanning DI, serialized DTOs, markup binding). Each plugin is ADD-ONLY: it can keep code alive
    // (avoid a false positive) but never mark live code dead. Keyed by camelCase plugin id.
    //
    // Unknown plugin ids and unknown per-plugin keys are NOT silently ignored — they print a visible
    // "warning:" so a typo (e.g. "reflectoin" or "enabldd") is caught instead of quietly no-opping.

    // reflection — ON by default. Keeps alive types/members named only via reflection strings/typeof:
    //   Type.GetType("Ns.Foo"), Activator.CreateInstance(typeof(Foo)/"Ns.Foo"),
    //   typeof(T).GetMethod("X") / x.GetType().GetMethod("X") (also GetProperty/GetField/GetEvent).
    // Conservative: only contributes when it can resolve the target symbol from the string/typeof.
    "reflection": { "enabled": true },

    // scanningDi — ON by default. Keeps alive types registered by ASSEMBLY-SCANNING DI, which name the
    // concrete type nowhere in source (the scan finds it reflectively). Roots types by SHAPE:
    //   • MediatR handlers    — implement IRequestHandler / INotificationHandler / IStreamRequestHandler
    //   • MassTransit         — implement IConsumer / IConsumer<T>
    //   • AutoMapper profiles — derive from a base named Profile
    // Framework types are matched by NAME (offline, no NuGet needed). Conservative: it roots ONLY types
    // wearing one of these framework markers (and the marker interface they satisfy) — it does NOT
    // blanket-root every interface implementer, so unrelated dead types stay flagged.
    "scanningDi": { "enabled": true },

    // blazorParameter — OFF by default (opt-in). Keeps alive Blazor component members set from .razor
    // markup or the DI container, which the walker never sees assigned in C#. Roots properties carrying
    // [Parameter] / [CascadingParameter] / [SupplyParameterFromQuery] / [EditorRequired] / [Inject]
    // (matched by attribute NAME, offline). Conservative: roots ONLY the attribute-bearing member and
    // its accessors — never blanket-roots a component's members, so plain siblings stay flagged. Enable
    // it if your solution has Blazor components:
    "blazorParameter": { "enabled": false },

    // serialization — OFF by default (opt-in). Keeps alive DTO data members touched only by a JSON
    // serializer (reflection over the type's properties/fields), which the walker never sees named in
    // source. Roots the public get/set PROPERTIES and public FIELDS of a DEMONSTRABLY-serialized type:
    //   • the type argument or the serialized value of a serialize/deserialize call —
    //     JsonSerializer.Serialize<T>/Deserialize<T> (System.Text.Json),
    //     JsonConvert.SerializeObject/DeserializeObject<T> (Newtonsoft), matched by method NAME offline;
    //   • plus any member wearing [JsonPropertyName] / [JsonProperty] / [DataMember] (matched by name).
    // Conservative: roots ONLY serialized types' own data members — never blanket-roots every property,
    // so non-serialized types' plain members and unrelated dead types stay flagged. Optional
    // "namespaces" glob list also roots the data members of types in matching namespaces (a "these are
    // DTOs" escape hatch for serialization the plugin cannot statically see). Enable it if your solution
    // serializes DTOs:
    "serialization": { "enabled": false, "namespaces": [] }
  }
}
