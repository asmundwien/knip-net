<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS0067;CS0169;CS0649;IDE0051;IDE0052</NoWarn>
    <!-- Not part of Knip.slnx; only ever restored + compiled at runtime by the WS3 test / MSBuildWorkspace. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- USED: Program.Main serializes via Newtonsoft.Json.JsonConvert -> the delivered assembly
         (Newtonsoft.Json) appears in the project's external-assembly use set -> NOT flagged. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />

    <!-- UNUSED: declared but no symbol in this project ever touches the Humanizer assembly it delivers
         -> FLAGGED as UnusedPackageReference (remediation removePackageReference), medium confidence. -->
    <PackageReference Include="Humanizer.Core" Version="2.14.1" />

    <!-- HAZARD (analyzer / source-generator, PrivateAssets="all"): delivers NO referenceable compile
         assembly, so its effect (polyfill codegen) is invisible to symbol edges. Per REVISED §3.8 it is
         EMITTED (never dropped) with the BuildOnlyPackage hazard + LOW confidence. -->
    <PackageReference Include="PolySharp" Version="1.14.1">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
