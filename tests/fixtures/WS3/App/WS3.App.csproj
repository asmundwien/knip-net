<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS0067;CS0169;CS0649;IDE0051;IDE0052</NoWarn>
    <!-- Not part of Knip.slnx; only ever restored + compiled at runtime by the WS3 test / MSBuildWorkspace. -->
  </PropertyGroup>

  <!-- Swashbuckle's SwaggerGen/Swagger/SwaggerUI assemblies (delivered via the metapackage's
       dependencies below) reference ASP.NET Core types, so the shared framework must be referenceable. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- USED: Program.Main serializes via Newtonsoft.Json.JsonConvert -> the delivered assembly
         (Newtonsoft.Json) appears in the project's external-assembly use set -> NOT flagged. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />

    <!-- METAPACKAGE (used): Swashbuckle.AspNetCore's OWN compile set is EMPTY — the functionality is
         delivered by its DEPENDENCY packages (Swashbuckle.AspNetCore.SwaggerGen/Swagger/SwaggerUI).
         Program.Main touches SwaggerGenOptions (from the SwaggerGen dependency assembly), so the
         DEPENDENCY-CLOSURE assembly set is exercised -> NOT flagged (regression guard: a used
         metapackage must not be reported unused nor mis-tagged buildOnlyPackage). -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
    <!-- UNUSED ORDINARY PACKAGE: its own Swagger assembly is untouched, while Program.Main uses
         Microsoft.OpenApi from this package's NETStandard dependency. Dependency usage must not make
         this ordinary package appear used. -->
    <PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="7.2.0" />

    <!-- UNUSED: declared but no symbol in this project ever touches the Humanizer assembly it delivers
         -> FLAGGED as UnusedPackageReference (remediation removePackageReference), medium confidence. -->
    <PackageReference Include="Humanizer.Core" Version="2.14.1" />

    <!-- BUILD-ONLY: contributes MSBuild props/targets but no compile assembly or package dependencies.
         Its effect is invisible to symbol edges, so it remains a low-confidence hazardous finding. -->
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="6.0.5" />

    <!-- HAZARD (analyzer / source-generator, PrivateAssets="all"): delivers NO referenceable compile
         assembly, so its effect (polyfill codegen) is invisible to symbol edges. Per REVISED §3.8 it is
         EMITTED (never dropped) with the BuildOnlyPackage hazard + LOW confidence. -->
    <PackageReference Include="PolySharp" Version="1.14.1">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
