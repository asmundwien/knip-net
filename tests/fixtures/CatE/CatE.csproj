<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- Deliberate dead code + unraised events; silence the noise so a fixture build is quiet. -->
    <NoWarn>CS0067;CS0169;CS0649;CS0660;CS0661;IDE0051;IDE0052</NoWarn>
    <!-- Not part of Knip.slnx; only ever compiled at runtime by MSBuildWorkspace. -->
  </PropertyGroup>

</Project>
