<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- OutputType=Exe: F6 top-level statements need an executable so the compiler synthesizes Main. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Deliberate dead code lives here; silence unused-member warnings so a fixture build is quiet. -->
    <NoWarn>CS0067;CS0169;CS0649;IDE0051;IDE0052</NoWarn>
    <!-- Not part of Knip.slnx; only ever compiled at runtime by MSBuildWorkspace. -->
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="RegularEntry/**/*.cs" />
  </ItemGroup>

</Project>
