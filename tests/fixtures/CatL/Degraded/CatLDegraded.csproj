<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS0067;CS0169;CS0649;IDE0051;IDE0052</NoWarn>
    <!-- ISOLATED: references an UNDECLARED type so Roslyn yields a TypeKind.Error, driving
         UnresolvedTypeReferences>0 → reliability.degraded == true (L3). Mirrors CatI/I7. -->
  </PropertyGroup>

</Project>
