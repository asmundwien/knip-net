<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS0067;CS0169;CS0649;IDE0051;IDE0052</NoWarn>
    <!-- L13/L14: an externally-visible dead symbol gets the publicApi hazard; C2 grades it medium when
         the user declared an API posture (publicApiProjects/treatAllPublicAsUsed set) and low otherwise.
         Not part of Knip.slnx; compiled at runtime by MSBuildWorkspace. -->
  </PropertyGroup>

</Project>
