<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Deliberate dead code lives here; silence unused-member warnings so a fixture build is quiet. -->
    <NoWarn>CS0067;CS0169;CS0649;IDE0051;IDE0052</NoWarn>
    <!-- Not part of Knip.slnx; only ever compiled at runtime by MSBuildWorkspace. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- The K4 two-project sub-fixture (K4.Lib / K4.Tests) lives in subfolders below this project.
         SDK default globbing would otherwise pull their .cs files into THIS compilation, so the K4
         test's [Fact] would root Widget.TestOnly here regardless of the ignore.projects flip — masking
         the K4 workaround. Exclude the K4 subtrees so each K4 file is owned only by its own project. -->
    <Compile Remove="K4.Lib/**/*.cs" />
    <Compile Remove="K4.Tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
