{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/asmundwien/knip-net/v0.1.0-preview.1/schemas/knip.config.schema.json",
  "title": "Knip.NET configuration (knip.json)",
  "description": "Analysis policy for a Knip.NET run. Invocation target and report format are command arguments.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "production": {
      "type": "boolean",
      "description": "Report production code reachable only through tests as onlyUsedByTests. --production also enables it."
    },
    "testProjects": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Project-name globs that classify test projects before assembly and name-based detection."
    },
    "entryPoints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "symbolNames": { "type": "array", "items": { "type": "string" } },
        "attributes": { "type": "array", "items": { "type": "string" } },
        "baseTypes": { "type": "array", "items": { "type": "string" } },
        "implementedInterfaces": { "type": "array", "items": { "type": "string" } },
        "namePatterns": { "type": "array", "items": { "type": "string" } }
      }
    },
    "roots": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "treatAllPublicAsUsed": { "type": "boolean" },
        "publicApiProjects": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ignore": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": { "type": "array", "items": { "type": "string" } },
        "symbols": { "type": "array", "items": { "type": "string" } },
        "namespaces": { "type": "array", "items": { "type": "string" } },
        "projects": { "type": "array", "items": { "type": "string" } }
      }
    },
    "plugins": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reflection": { "$ref": "#/$defs/enabledPlugin" },
        "scanningDi": { "$ref": "#/$defs/aliasedPlugin" },
        "blazorParameter": { "$ref": "#/$defs/aliasedPlugin" },
        "serialization": { "$ref": "#/$defs/serializationPlugin" },
        "aspnetcore": { "$ref": "#/$defs/aliasedPlugin" }
      }
    }
  },
  "$defs": {
    "aliases": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      }
    },
    "enabledPlugin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "aliasedPlugin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "aliases": { "$ref": "#/$defs/aliases" }
      }
    },
    "serializationPlugin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "aliases": { "$ref": "#/$defs/aliases" },
        "namespaces": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
