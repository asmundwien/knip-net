<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net472</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Knip.Cli</RootNamespace>

    <RollForward>LatestMajor</RollForward>

    <!-- The global tool is packed for net10.0 only. The net472 target remains a compile-time contract
         for legacy MSBuild hosts and is excluded from the tool package below. -->
    <PackageId>AsmundWien.Knip</PackageId>
    <Version>0.1.0-preview.1</Version>
    <Authors>AsmundWien</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/asmundwien/knip-net</RepositoryUrl>
    <Description>Knip.NET finds unused code and project or package references across .NET solutions.</Description>
    <PackageTags>dead-code;roslyn;dotnet-tool;analyzer;knip;unused-code;static-analysis;cleanup;migration</PackageTags>
  </PropertyGroup>

  <!-- Global-tool packaging. A .NET tool runs on .NET (not .NET Framework), so the tool is built and
       packed for net10.0 ONLY. `PackAsTool` must be TRUE in the OUTER (TFM-less) evaluation too — that
       is where NuGet stamps the `DotnetTool` package type into the nuspec; without it `dotnet tool
       install` rejects the package ("… is not a .NET tool"). But `PackAsTool=true` on the INNER net472
       build trips NETSDK1054 (PackAsTool only supports .NET Core). So: turn PackAsTool ON everywhere
       EXCEPT the net472 inner build, whose build output is additionally excluded from the package. -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-knip</ToolCommandName>
  </PropertyGroup>

  <!-- net472 stays a normal build target (the legacy-analysis story needs it to COMPILE), but it is not
       the tool distribution: disable PackAsTool for its inner build (avoids NETSDK1054) and keep its
       build output out of the nuspec. The outer/net10 builds above still carry the DotnetTool type. -->
  <PropertyGroup Condition="'$(TargetFramework)'=='net472'">
    <PackAsTool>false</PackAsTool>
    <IncludeBuildOutput>false</IncludeBuildOutput>
  </PropertyGroup>

  <!-- Excluding net472's build output leaves a net472 dependency group in the nuspec with no matching
       lib/ref folder (NU5128). That is intentional for this tool package (net472 is never distributed),
       so silence the packaging-only warning; it does not apply to build (`-warnaserror` on build stays). -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Locator must be able to find the SDK's MSBuild; keep it out of the way of Roslyn's copy. -->
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageReference Include="JsonSchema.Net" Version="7.3.4" />
  </ItemGroup>

  <!-- Do not ship MSBuild assemblies; Locator loads the SDK's/VS's copies at runtime (MSBL001).
       Version is per-TFM: net472's Roslyn 4.14.0 requires Build.Framework >= 17.13.9, so pin the
       patched 17.14.28 there (avoids an NU1605 downgrade vs. the transitive floor). -->
  <ItemGroup Condition="'$(TargetFramework)'=='net10.0'">
    <PackageReference Include="Microsoft.Build.Framework" Version="17.11.48" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)'=='net472'">
    <PackageReference Include="Microsoft.Build.Framework" Version="17.14.28" ExcludeAssets="runtime" PrivateAssets="all" />
    <!-- Roslyn 4.14.0's Workspaces.MSBuild drags Microsoft.Build transitively into this exe; Locator
         (MSBL001) requires MSBuild assemblies to be reference-only so it can load the machine's copies
         at runtime. Pin the patched 17.14.28 (reference-only) to satisfy that and avoid the advisory. -->
    <PackageReference Include="Microsoft.Build" Version="17.14.28" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.14.28" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="17.14.28" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.StringTools" Version="17.14.28" ExcludeAssets="runtime" PrivateAssets="all" />
    <!-- Reference assemblies so net472 COMPILES cross-platform (no full .NET Framework install). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\schemas\knip.config.schema.json"
                      Link="Schemas\knip.config.schema.json"
                      LogicalName="Knip.Cli.Schemas.knip.config.schema.json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Knip.Core\Knip.Core.csproj" />
  </ItemGroup>

</Project>
