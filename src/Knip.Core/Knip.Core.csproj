<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Knip.Core</RootNamespace>
    <!-- RS1039: generic Enter<T> never receives field/event-field nodes (handled separately), so
         GetDeclaredSymbol resolves correctly at runtime. CS0618: WorkspaceFailed is still supported. -->
    <NoWarn>$(NoWarn);RS1039;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.6.0" />
  </ItemGroup>

</Project>
